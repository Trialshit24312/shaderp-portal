# Copy to .env for local dev — on Render set these in the dashboard Environment tab

PORT=8787
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# Discord Developer Portal → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:8787/auth/discord/callback

# Bot token (needs "Server Members Intent" + bot in your guild)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

DISCORD_INVITE_URL=https://discord.gg/sbnu98HYAZ

# Map Discord role IDs → portal roles (highest match wins)
# Get role IDs: Discord Settings → Advanced → Developer Mode → right-click role → Copy ID
PORTAL_ROLE_MAP={"OWNER_ROLE_ID":"owner","ADMIN_ROLE_ID":"admin","DEV_ROLE_ID":"developer","STAFF_ROLE_ID":"staff","MOD_ROLE_ID":"moderator","MEMBER_ROLE_ID":"member"}

# Optional: comma-separated Discord user IDs allowed to unban (defaults to first PORTAL_OWNER_IDS)
# AC_UNBAN_DISCORD_IDS=1170463252698902561
PORTAL_OWNER_IDS=

# Protect POST /api/dashboard/sync from your local machine
SYNC_API_KEY=generate-a-long-random-key

# Web queue — FiveM shade-queue uses this key (set same value in server.cfg)
QUEUE_API_KEY=generate-another-long-random-key
QUEUE_ENABLED=1

# ShadeRP Anti-Cheat (shaderp-ac) — same key in server.cfg shade:acApiKey
AC_API_KEY=
AC_ENABLED=1
# Optional: Discord webhook for live detection alerts from portal
AC_DISCORD_WEBHOOK=

# AC Discord slash commands (/ac ban, watch, kick…) — uses DISCORD_BOT_TOKEN by default
AC_DISCORD_SLASH_COMMANDS=1
# Join screening — comma-separated cheat Discord guild IDs (bot must be in those guilds)
AC_CHEAT_DISCORD_GUILDS=
AC_REQUIRE_DISCORD_MEMBER=0
# Block joins when portal join-screen is down (fail-closed). FXServer: set shade:acJoinFailClosed 1
AC_JOIN_FAIL_CLOSED=0

# Optional PostgreSQL for AC state (falls back to data/ac-state.json)
# DATABASE_URL=postgres://user:pass@localhost:5432/shaderp
# DATABASE_SSL=1

# Optional Redis for real-time trust cache (flushes to Postgres every 5 min)
# REDIS_URL=redis://localhost:6379

# WebRTC TURN (symmetric NAT) — also set shade:turnUrl on FXServer
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# AC_ML_THRESHOLD=72

# Unified ShadeRP Discord bot
DISCORD_BOT_ENABLED=1

# Multi-guild Discord network (5 ShadeRP servers)
DISCORD_GUILD_ID=1357838976299565087
DISCORD_GUILD_EMS_ID=1474128332407705805
DISCORD_GUILD_DOJ_ID=1482426392132980738
DISCORD_GUILD_JOBS_ID=1505960227466641608
DISCORD_GUILD_APPEALS_ID=1523085526758985878
DISCORD_GUILDS=1357838976299565087,1474128332407705805,1482426392132980738,1505960227466641608,1523085526758985878

# Ticket system — channel for threads OR category for private channels
DISCORD_TICKET_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=

# Server logs (shade-crashlog → staff panel) — set shade:logsSyncEnabled 1 on FXServer
LOGS_API_KEY=
LOGS_ENABLED=1
LOGS_MAX_ENTRIES=600
LOGS_RETENTION_DAYS=30

# After Render deploy — for Sync-PortalToRender.ps1 (optional in .env, not needed on Render)
PORTAL_URL=https://YOUR-APP.onrender.com

# Optional: auto-detect rules/faq channels by name (Fetch-DiscordContent.ps1)
DISCORD_CHANNEL_RULES=rules
DISCORD_CHANNEL_FAQ=faq
DISCORD_CHANNEL_ANNOUNCEMENTS=announcements

# Public site branding
PORTAL_NAME=ShadeRP
PORTAL_TAGLINE=ESX Legacy Roleplay
